# Copy ไฟล์นี้เป็น .env แล้วกรอกค่า
# (ไม่ต้อง commit ไฟล์ .env ขึ้น GitHub)

# MongoDB Atlas connection string
# ได้จาก Atlas → Clusters → Connect → Drivers → Copy connection string
MONGO_URI=mongodb+srv://<username>:<password>@platform-hr-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ชื่อ database (สร้างอัตโนมัติถ้ายังไม่มี)
DB_NAME=project_dashboard

# ชื่อ collection
COLLECTION=projects_db

# รหัสผ่านลับ (ตั้งค่าใน Render environment variables ด้วย)
# ถ้าไม่ต้องการใช้ก็เว้นว่างไว้
API_SECRET=your-secret-key-here

# Port (Render จะ set ให้อัตโนมัติ)
PORT=3000
